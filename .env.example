# Base Postgres. En local : le Docker de docker-compose.yml (valeur par défaut, rien à définir).
# Sur Vercel : posée automatiquement par l'intégration Neon (DATABASE_URL, DATABASE_URL_UNPOOLED).
NUXT_DATABASE_URL=postgres://titine:titine@localhost:5435/titine

# Origine publique : URL canoniques, sitemap, aperçus de partage.
# Sur Vercel, le domaine de production est utilisé par défaut.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Protège /api/cron/fuel-ingest (Vercel l'envoie lui-même à ses crons). Générer : openssl rand -hex 32
CRON_SECRET=

# Facultatif : Google Analytics 4 (identifiant de mesure). Chargé seulement après accord du visiteur.
# NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Facultatif : autre style de carte compatible MapLibre
# NUXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/fiord
